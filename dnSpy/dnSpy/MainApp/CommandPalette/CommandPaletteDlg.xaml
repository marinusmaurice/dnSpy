<ctrls:WindowBase x:Class="dnSpy.MainApp.CommandPalette.CommandPaletteDlg"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrls="clr-namespace:dnSpy.Contracts.Controls;assembly=dnSpy.Contracts.DnSpy"
        xmlns:mvvm="clr-namespace:dnSpy.Contracts.MVVM;assembly=dnSpy.Contracts.DnSpy"
        xmlns:img="clr-namespace:dnSpy.Contracts.Images;assembly=dnSpy.Contracts.DnSpy"
        xmlns:p="clr-namespace:dnSpy.Properties"
        Style="{StaticResource DialogWindowStyle}" WindowStartupLocation="CenterOwner"
        Width="700" Height="450"
        MinWidth="400" MinHeight="200"
        ShowInTaskbar="False"
        Title="{x:Static p:dnSpy_Resources.CommandPalette_Title}">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBox Grid.Row="0" Name="searchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{x:Static p:dnSpy_Resources.CommandPalette_Search_ToolTip}" />
        <ListBox Grid.Row="1" Name="listBox" Margin="0 5 0 0"
                 MouseDoubleClick="ListBox_MouseDoubleClick"
                 VirtualizingStackPanel.IsVirtualizing="True"
                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                 mvvm:InitDataTemplateAP.Initialize="True"
                 mvvm:AutomationPeerMemoryLeakWorkaround.Initialize="True"
                 SelectionMode="Single"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ItemsSource="{Binding Items}"
                 SelectedItem="{Binding SelectedItem}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <img:DsImage Grid.Column="0" Name="image" ImageReference="{Binding ImageReference}" Margin="0 0 4 0" />
                        <TextBlock Grid.Column="0" Name="check" Text="✓" Visibility="Collapsed" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{Binding InputGestureText}" Margin="10 0 0 0" Opacity="0.7" />
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding HasImage}" Value="False">
                            <Setter TargetName="image" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HasImage}" Value="False" />
                                <Condition Binding="{Binding IsChecked}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="check" Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="2" Margin="0 5 0 0" Text="{x:Static p:dnSpy_Resources.CommandPalette_NoMatches}" Visibility="{Binding HasNoItems, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </Grid>
</ctrls:WindowBase>
