<ctrls:WindowBase x:Class="dnSpy.Documents.Containers.OpenFromNuGetDlg"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrls="clr-namespace:dnSpy.Contracts.Controls;assembly=dnSpy.Contracts.DnSpy"
        xmlns:mvvm="clr-namespace:dnSpy.Contracts.MVVM;assembly=dnSpy.Contracts.DnSpy"
        xmlns:p="clr-namespace:dnSpy.Properties"
        Style="{StaticResource DialogWindowStyle}" WindowStartupLocation="CenterOwner"
        MinHeight="300" MinWidth="500"
        Title="{x:Static p:dnSpy_Resources.OpenNuGet_Title}" Height="560" Width="860"
        FocusManager.FocusedElement="{Binding ElementName=searchBox}">
    <Grid>
        <Grid.Resources>
            <BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="5 5 5 0" TextWrapping="Wrap" Text="{x:Static p:dnSpy_Resources.OpenNuGet_Description}" />

        <Grid Grid.Row="1" Margin="5 5 5 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Margin="0 0 5 0" Padding="0" VerticalAlignment="Center" Content="{x:Static p:dnSpy_Resources.OpenNuGet_Search_Label}" Target="{Binding ElementName=searchBox}" />
            <TextBox Grid.Column="1" Name="searchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{x:Static p:dnSpy_Resources.OpenNuGet_Search_ToolTip}" />
            <CheckBox Grid.Column="2" Margin="10 0 0 0" VerticalAlignment="Center" Content="{x:Static p:dnSpy_Resources.OpenNuGet_Prerelease}" IsChecked="{Binding IncludePrerelease}" />
        </Grid>

        <Grid Grid.Row="2" Margin="5 5 5 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="230" />
            </Grid.ColumnDefinitions>
            <ListView Name="listView"
                      Grid.Column="0"
                      MouseDoubleClick="ListView_MouseDoubleClick"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      mvvm:InitDataTemplateAP.Initialize="True"
                      mvvm:AutomationPeerMemoryLeakWorkaround.Initialize="True"
                      SelectionMode="Single"
                      ItemsSource="{Binding Packages}"
                      SelectedItem="{Binding SelectedPackage}">
                <ListView.View>
                    <GridView AllowsColumnReorder="True">
                        <GridViewColumn Header="{x:Static p:dnSpy_Resources.OpenNuGet_Package_Column}" Width="200" DisplayMemberBinding="{Binding Id, Mode=OneTime}" />
                        <GridViewColumn Header="{x:Static p:dnSpy_Resources.OpenNuGet_Version_Column}" Width="80" DisplayMemberBinding="{Binding Version, Mode=OneTime}" />
                        <GridViewColumn Header="{x:Static p:dnSpy_Resources.OpenNuGet_Downloads_Column}" Width="75" DisplayMemberBinding="{Binding Downloads, Mode=OneTime}" />
                        <GridViewColumn Header="{x:Static p:dnSpy_Resources.OpenNuGet_Description_Column}" Width="300" DisplayMemberBinding="{Binding ShortDescription, Mode=OneTime}" />
                    </GridView>
                </ListView.View>
            </ListView>
            <Grid Grid.Column="1" Margin="5 0 0 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" FontWeight="Bold" TextWrapping="Wrap" Text="{Binding SelectedPackage.Id}" />
                <TextBlock Grid.Row="1" Margin="0 2 0 0" TextWrapping="Wrap" Text="{Binding SelectedPackage.Authors}" />
                <Label Grid.Row="2" Margin="0 8 0 2" Padding="0" Content="{x:Static p:dnSpy_Resources.OpenNuGet_Version_Label}" Target="{Binding ElementName=versionBox}" />
                <ComboBox Grid.Row="3" Name="versionBox" ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" />
                <ScrollViewer Grid.Row="4" Margin="0 8 0 0" VerticalScrollBarVisibility="Auto">
                    <TextBlock TextWrapping="Wrap" Text="{Binding SelectedPackage.Description}" />
                </ScrollViewer>
            </Grid>
        </Grid>

        <Grid Grid.Row="3" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar Name="progressBar" Grid.Column="0" IsIndeterminate="True" Margin="0 0 5 0" Visibility="{Binding IsSearching, Converter={StaticResource booleanToVisibilityConverter}}" />
            <TextBlock Grid.Column="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding StatusText}" Visibility="{Binding IsNotSearching, Converter={StaticResource booleanToVisibilityConverter}}" />
            <Button Grid.Column="1" Content="{x:Static p:dnSpy_Resources.OpenNuGet_Open_Button}" Style="{StaticResource DialogButton}" Margin="0 0 5 0" IsDefault="True" IsEnabled="{Binding CanOpen}" Click="okButton_Click" />
            <Button Grid.Column="2" Content="{x:Static p:dnSpy_Resources.Button_Cancel}" Style="{StaticResource DialogButton}" IsCancel="True" />
        </Grid>
    </Grid>
</ctrls:WindowBase>
