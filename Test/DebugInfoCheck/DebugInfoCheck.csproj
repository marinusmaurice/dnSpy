<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Debugger info regression test for C# (ILSpy 11). Compiled against a dnSpy build's DLLs (pass -p:DnSpyBin=<folder>),
    and run with the same folder: DebugInfoCheck <dnSpy DLL folder> <assembly>...
    check.ps1 runs it, see ../DecompilerStress/README.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <DnSpyBin Condition=" '$(DnSpyBin)' == '' ">$(MSBuildThisFileDirectory)..\..\dnSpy\dnSpy\bin\Release\net10.0-windows\</DnSpyBin>
  </PropertyGroup>

  <ItemGroup>
    <!-- Loaded from the dnSpy build at runtime (Program.cs), not copied -->
    <Reference Include="$(DnSpyBin)\dnlib.dll" Private="false" />
    <Reference Include="$(DnSpyBin)\dnSpy.Contracts.Logic.dll" Private="false" />
    <Reference Include="$(DnSpyBin)\dnSpy.Decompiler.ILSpyModern.Core.dll" Private="false" />
  </ItemGroup>

</Project>
