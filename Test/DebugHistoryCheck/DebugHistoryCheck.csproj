<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Time-travel debugging (Debug History) test: compiles dnSpy.Debugger's snapshot and history classes
    (they don't use WPF or debugger objects) and checks the ring buffer, Step Back/Forward and the value diff.
    check.ps1 runs it, see ../DecompilerStress/README.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>13.0</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Extensions\dnSpy.Debugger\dnSpy.Debugger\History\DbgHistory.cs" Link="History\DbgHistory.cs" />
    <Compile Include="..\..\Extensions\dnSpy.Debugger\dnSpy.Debugger\History\DbgHistorySnapshot.cs" Link="History\DbgHistorySnapshot.cs" />
    <Compile Include="..\..\Extensions\dnSpy.Debugger\dnSpy.Debugger\History\DbgHistoryDiff.cs" Link="History\DbgHistoryDiff.cs" />
  </ItemGroup>

</Project>
