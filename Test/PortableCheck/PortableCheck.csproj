<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Portable mode test: compiles dnSpy's AppDirectories on its own, copies itself into dnSpy-like folder layouts (files
    in a 'bin' sub dir, with and without dnSpy.xml next to dnSpy.exe or in bin) and checks the settings and data
    directories each layout gets. check.ps1 runs it, see ../DecompilerStress/README.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>13.0</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\dnSpy\dnSpy.Contracts.DnSpy\App\AppDirectories.cs" Link="App\AppDirectories.cs" />
    <Compile Include="..\..\dnSpy\dnSpy.Contracts.Logic\NRT_Helpers.cs" Link="App\NRT_Helpers.cs" />
  </ItemGroup>

</Project>
