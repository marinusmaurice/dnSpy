<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Command palette test: compiles dnSpy's command palette matcher and symbol names (they don't use WPF) and checks the fuzzy
    matching, the order of the results, the access key removal and the type/member texts.
    check.ps1 runs it, see ../DecompilerStress/README.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>13.0</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\dnSpy\dnSpy\MainApp\CommandPalette\CommandPaletteMatcher.cs" Link="CommandPalette\CommandPaletteMatcher.cs" />
    <Compile Include="..\..\dnSpy\dnSpy\MainApp\CommandPalette\CommandPaletteSymbols.cs" Link="CommandPalette\CommandPaletteSymbols.cs" />
    <PackageReference Include="dnlib" Version="4.5.0" />
  </ItemGroup>

</Project>
