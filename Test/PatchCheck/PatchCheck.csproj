<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Patch export/import test: compiles dnSpy's assembly diff and patch classes (they only use dnlib), makes a patch from
    ../PatchCases v1 and its edited version, saves and loads it, and applies it to v2.
    check.ps1 runs it, see ../DecompilerStress/README.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>13.0</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\dnSpy\dnSpy.Decompiler\Diff\AssemblyDiff.cs" Link="Diff\AssemblyDiff.cs" />
    <Compile Include="..\..\dnSpy\dnSpy.Decompiler\Patch\*.cs" Link="Patch\%(Filename)%(Extension)" />
    <PackageReference Include="dnlib" Version="4.5.0" />
  </ItemGroup>

</Project>
