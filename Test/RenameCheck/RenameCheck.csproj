<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Rename map test: compiles dnSpy's rename map classes (they only use dnlib), "obfuscates" ../RenameCases v1 and v2
    with other names, renames some of obfuscated v1 back, makes a rename map, saves and loads it, and applies it to
    obfuscated v2. check.ps1 runs it, see ../DecompilerStress/README.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>13.0</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\dnSpy\dnSpy.Decompiler\Rename\*.cs" Link="Rename\%(Filename)%(Extension)" />
    <PackageReference Include="dnlib" Version="4.5.0" />
  </ItemGroup>

</Project>
