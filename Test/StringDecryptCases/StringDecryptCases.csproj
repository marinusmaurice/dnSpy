<Project Sdk="Microsoft.NET.Sdk">

  <!--
    String decryption test app (see ../DecompilerStress/check.ps1): strings encrypted like obfuscators do, decrypted by
    dnSpy.Console's decrypt-strings option. Data.cs and strings.bin are made by generate.ps1.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="strings.bin" LogicalName="strings.bin" />
  </ItemGroup>

</Project>
