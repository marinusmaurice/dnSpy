<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Side-by-side view test: compiles dnSpy's side-by-side language picker and tab pair (they don't use WPF) and checks which
    language is shown next to which, and that a sync doesn't bounce back.
    check.ps1 runs it, see ../DecompilerStress/README.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>13.0</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\dnSpy\dnSpy\Documents\Tabs\SideBySide\SideBySideLanguagePicker.cs" Link="SideBySide\SideBySideLanguagePicker.cs" />
    <Compile Include="..\..\dnSpy\dnSpy\Documents\Tabs\SideBySide\SideBySidePair.cs" Link="SideBySide\SideBySidePair.cs" />
    <Compile Include="..\..\dnSpy\dnSpy.Contracts.Logic\Decompiler\DecompilerConstants.cs" Link="Decompiler\DecompilerConstants.cs" />
  </ItemGroup>

</Project>
