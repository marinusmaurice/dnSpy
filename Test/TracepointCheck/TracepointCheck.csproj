<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tracepoint message test: compiles dnSpy.Debugger's tracepoint message parser (it doesn't use WPF or debugger objects)
    and checks the keywords ($HITCOUNT, $TICK, $TIME and the older ones), escapes and {expressions}.
    check.ps1 runs it, see ../DecompilerStress/README.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>13.0</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Extensions\dnSpy.Debugger\dnSpy.Debugger\Breakpoints\Code\CondChecker\ParsedTracepointMessage.cs" Link="CondChecker\ParsedTracepointMessage.cs" />
    <Compile Include="..\..\Extensions\dnSpy.Debugger\dnSpy.Debugger\Breakpoints\Code\CondChecker\TracepointMessageParser.cs" Link="CondChecker\TracepointMessageParser.cs" />
    <None Include="..\..\Extensions\dnSpy.Debugger\dnSpy.Debugger\Dialogs\CodeBreakpoints\ShowCodeBreakpointSettingsVM.cs" Link="ShowCodeBreakpointSettingsVM.cs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
