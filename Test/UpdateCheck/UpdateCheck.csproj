<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Update check test: compiles dnSpy's release tag parser and release choice (no network or WPF) and checks
    the tags (v7.22.0.0, v7.22.0.0-beta.1) and which release of a release list is offered with and without betas.
    check.ps1 runs it, see ../DecompilerStress/README.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>13.0</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\dnSpy\dnSpy\MainApp\Update\ReleaseSelector.cs" Link="ReleaseSelector.cs" />
  </ItemGroup>

</Project>
