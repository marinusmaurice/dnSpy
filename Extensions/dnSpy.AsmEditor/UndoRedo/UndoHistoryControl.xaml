<UserControl x:Class="dnSpy.AsmEditor.UndoRedo.UndoHistoryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="clr-namespace:dnSpy.AsmEditor.Properties">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Margin="5 4 5 4" TextWrapping="Wrap" Foreground="{DynamicResource SystemColorsGrayText}" Text="{x:Static p:dnSpy_AsmEditor_Resources.UndoHistory_Help}" />
        <ListView Grid.Row="1" Name="listView" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" SelectionMode="Single" MouseDoubleClick="ListView_MouseDoubleClick" KeyDown="ListView_KeyDown">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                            <Setter Property="FontWeight" Value="Bold" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsUndone}" Value="True">
                            <Setter Property="FontStyle" Value="Italic" />
                            <Setter Property="Opacity" Value="0.55" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="22" DisplayMemberBinding="{Binding Marker}" />
                    <GridViewColumn Header="#" Width="34" DisplayMemberBinding="{Binding Number}" />
                    <GridViewColumn Header="{x:Static p:dnSpy_AsmEditor_Resources.UndoHistory_Column_Edit}" Width="220" DisplayMemberBinding="{Binding Description}" />
                    <GridViewColumn Header="{x:Static p:dnSpy_AsmEditor_Resources.UndoHistory_Column_Files}" Width="150" DisplayMemberBinding="{Binding Documents}" />
                    <GridViewColumn Header="{x:Static p:dnSpy_AsmEditor_Resources.UndoHistory_Column_Time}" Width="80" DisplayMemberBinding="{Binding Time}" />
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>
