<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:p="clr-namespace:dnSpy.Debugger.Properties;assembly=dnSpy.Debugger.x"
                    xmlns:dbg="clr-namespace:dnSpy.Debugger.Settings"
                    xmlns:hist="clr-namespace:dnSpy.Debugger.History">

    <Style x:Key="DbgTableGridViewScrollViewerStyle"
           BasedOn="{StaticResource {x:Static GridView.GridViewScrollViewerStyleKey}}"
           TargetType="{x:Type ScrollViewer}">
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>

    <DataTemplate DataType="{x:Type dbg:DebuggerAppSettingsPage}">
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <GroupBox Grid.Row="0" Margin="0 5 0 0" Header="{x:Static p:dnSpy_Debugger_Resources.DbgSettings_DisableDebuggerDetection}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Row="0" Grid.Column="0" Margin="0 5 0 0" IsChecked="{Binding Settings.AntiIsDebuggerPresent}" Content="IsDebuggerPresent" />
                    <CheckBox Grid.Row="0" Grid.Column="1" Margin="5 5 0 0" IsChecked="{Binding Settings.AntiCheckRemoteDebuggerPresent}" Content="CheckRemoteDebuggerPresent" />
                    <CheckBox Grid.Row="1" Grid.Column="0" Margin="0 5 0 0" IsChecked="{Binding Settings.PreventManagedDebuggerDetection}" Content="System.Diagnostics.Debugger" />
                </Grid>
            </GroupBox>
            <CheckBox Grid.Row="1" Margin="0 5 0 0" IsChecked="{Binding Settings.PropertyEvalAndFunctionCalls}" Content="{x:Static p:dnSpy_Debugger_Resources.DbgSettings_PropertyEvalAndFunctionCalls}" />
            <CheckBox Grid.Row="2" Margin="0 5 0 0" IsChecked="{Binding Settings.UseStringConversionFunction}" Content="{x:Static p:dnSpy_Debugger_Resources.DbgSettings_UseStringConversionFunction}" IsEnabled="{Binding Settings.PropertyEvalAndFunctionCalls}" />
            <CheckBox Grid.Row="3" Margin="0 5 0 0" IsChecked="{Binding Settings.StepOverPropertiesAndOperators}" Content="{x:Static p:dnSpy_Debugger_Resources.DbgSettings_StepOverPropertiesAndOperators}" />
            <CheckBox Grid.Row="4" Margin="0 5 0 0" IsChecked="{Binding Settings.IgnoreBreakInstructions}" Content="{x:Static p:dnSpy_Debugger_Resources.DbgSettings_IgnoreBreakInstructions}" />
            <CheckBox Grid.Row="5" Margin="0 5 0 0" IsChecked="{Binding Settings.AutoOpenLocalsWindow}" Content="{x:Static p:dnSpy_Debugger_Resources.DbgSettings_AutoOpenLocalsWindow}" />
            <CheckBox Grid.Row="6" Margin="0 5 0 0" IsChecked="{Binding Settings.UseMemoryModules}" Content="{x:Static p:dnSpy_Debugger_Resources.DbgSettings_UseMemoryModules}" />
            <CheckBox Grid.Row="7" Margin="0 5 0 0" IsChecked="{Binding Settings.BreakAllProcesses}" Content="{x:Static p:dnSpy_Debugger_Resources.DbgSettings_BreakAllProcesses}" />
            <CheckBox Grid.Row="8" Margin="0 5 0 0" IsChecked="{Binding Settings.AsyncDebugging}" Content="{x:Static p:dnSpy_Debugger_Resources.DbgSettings_AsyncDebugging}" />
            <CheckBox Grid.Row="9" Margin="0 5 0 0" IsChecked="{Binding Settings.FocusActiveProcess}" Content="{x:Static p:dnSpy_Debugger_Resources.DbgSettings_FocusActiveProcess}" />
            <CheckBox Grid.Row="10" Margin="0 5 0 0" IsChecked="{Binding Settings.FocusDebuggerWhenProcessBreaks}" Content="{x:Static p:dnSpy_Debugger_Resources.DbgSettings_FocusDebuggerWhenProcessBreaks}" />
            <CheckBox Grid.Row="11" Margin="0 5 0 0" IsChecked="{Binding Settings.RedirectGuiConsoleOutput}" Content="{x:Static p:dnSpy_Debugger_Resources.DbgSettings_RedirectGuiConsoleOutput}" />
            <CheckBox Grid.Row="12" Margin="0 5 0 0" IsChecked="{Binding Settings.EnableManagedDebuggingAssistants}" Content="{x:Static p:dnSpy_Debugger_Resources.DbgSettings_EnableManagedDebuggingAssistants}" />
            <CheckBox Grid.Row="13" Margin="0 5 0 0" IsChecked="{Binding Settings.ShowRawStructureOfObjects}" Content="{x:Static p:dnSpy_Debugger_Resources.DbgSettings_ShowRawStructureOfObjects}" />
            <CheckBox Grid.Row="14" Margin="0 5 0 0" IsChecked="{Binding Settings.IgnoreUnhandledExceptions}" Content="{x:Static p:dnSpy_Debugger_Resources.DbgSettings_IgnoreUnhandledExceptions}" />
            <GroupBox Grid.Row="15" Margin="0 5 0 0" Header="{x:Static p:dnSpy_Debugger_Resources.DbgSettings_SuppressJITOptimization}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <CheckBox Grid.Row="0" Margin="0 5 0 0" IsChecked="{Binding Settings.SuppressJITOptimization_SystemModules}" Content="{x:Static p:dnSpy_Debugger_Resources.DbgSettings_SuppressJITOptimization_SystemModules}" />
                    <CheckBox Grid.Row="1" Margin="0 5 0 0" IsChecked="{Binding Settings.SuppressJITOptimization_ProgramModules}" Content="{x:Static p:dnSpy_Debugger_Resources.DbgSettings_SuppressJITOptimization_ProgramModules}" />
                </Grid>
            </GroupBox>
            <CheckBox Grid.Row="16" Margin="0 5 0 0" IsChecked="{Binding Settings.HideCompilerGeneratedMembers}" Content="{x:Static p:dnSpy_Debugger_Resources.DbgSettings_HideCompilerGeneratedMembers}" />
            <CheckBox Grid.Row="17" Margin="0 5 0 0" IsChecked="{Binding Settings.RespectHideMemberAttributes}" Content="{x:Static p:dnSpy_Debugger_Resources.DbgSettings_RespectHideMemberAttributes}" />
            <CheckBox Grid.Row="18" Margin="0 5 0 0" IsChecked="{Binding Settings.HideDeprecatedError}" Content="{x:Static p:dnSpy_Debugger_Resources.DbgSettings_HideDeprecatedError}" />
            <CheckBox Grid.Row="19" Margin="0 5 0 0" IsChecked="{Binding Settings.SortParameters}" Content="{x:Static p:dnSpy_Debugger_Resources.DbgSettings_SortParameters}" />
            <CheckBox Grid.Row="20" Margin="0 5 0 0" IsChecked="{Binding Settings.SortLocals}" Content="{x:Static p:dnSpy_Debugger_Resources.DbgSettings_SortLocals}" />
            <CheckBox Grid.Row="21" Margin="0 5 0 0" IsChecked="{Binding Settings.GroupParametersAndLocalsTogether}" Content="{x:Static p:dnSpy_Debugger_Resources.DbgSettings_GroupParametersAndLocalsTogether}" />
            <CheckBox Grid.Row="22" Margin="0 5 0 0" IsChecked="{Binding Settings.ShowCompilerGeneratedVariables}" Content="{x:Static p:dnSpy_Debugger_Resources.DbgSettings_ShowCompilerGeneratedVariables}" />
            <CheckBox Grid.Row="23" Margin="0 5 0 0" IsChecked="{Binding Settings.ShowDecompilerGeneratedVariables}" Content="{x:Static p:dnSpy_Debugger_Resources.DbgSettings_ShowDecompilerGeneratedVariables}" />
            <CheckBox Grid.Row="24" Margin="0 5 0 0" IsChecked="{Binding Settings.ShowRawLocals}" Content="{x:Static p:dnSpy_Debugger_Resources.DbgSettings_ShowRawLocals}" />
            <CheckBox Grid.Row="25" Margin="0 5 0 0" IsChecked="{Binding Settings.ShowReturnValues}" Content="{x:Static p:dnSpy_Debugger_Resources.DbgSettings_ShowReturnValues}" />
            <CheckBox Grid.Row="26" Margin="0 5 0 0" IsChecked="{Binding Settings.HighlightChangedVariables}" Content="{x:Static p:dnSpy_Debugger_Resources.DbgSettings_HighlightChangedVariables}" />
            <CheckBox Grid.Row="27" Margin="0 5 0 0" IsChecked="{Binding Settings.SyntaxHighlight}" Content="{x:Static p:dnSpy_Debugger_Resources.DbgSettings_SyntaxHighlight}" />
            <GroupBox Grid.Row="28" Margin="0 5 0 0" Header="{x:Static p:dnSpy_Debugger_Resources.DbgSettings_Language}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Grid.Row="0" Grid.Column="0" Margin="0 0 5 0" Content="{x:Static p:dnSpy_Debugger_Resources.DbgSettings_DebugEngine}" />
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0 0 5 0" HorizontalAlignment="Stretch" DisplayMemberPath="Name" ItemsSource="{Binding Runtimes.Items}" SelectedItem="{Binding Runtimes.SelectedItem}" VerticalContentAlignment="Center" />
                    <Label Grid.Row="1" Grid.Column="0" Margin="0 0 5 0" Content="{x:Static p:dnSpy_Debugger_Resources.DbgSettings_Language}" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Margin="0 0 5 0" HorizontalAlignment="Stretch" DisplayMemberPath="Name" ItemsSource="{Binding Runtimes.SelectedItem.Languages}" SelectedItem="{Binding Runtimes.SelectedItem.SelectedItem}" VerticalContentAlignment="Center" />
                </Grid>
            </GroupBox>
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type hist:DbgHistoryAppSettingsPage}">
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <CheckBox Grid.Row="0" Grid.ColumnSpan="3" Margin="0 5 0 0" IsChecked="{Binding Settings.IsEnabled}" Content="{x:Static p:dnSpy_Debugger_Resources.DbgHistory_Settings_Record}" />
            <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Margin="0 5 0 5" TextWrapping="Wrap" Text="{x:Static p:dnSpy_Debugger_Resources.DbgHistory_Settings_Info}" />
            <Label Grid.Row="2" Grid.Column="0" Margin="0 5 5 0" Target="{Binding ElementName=histHistorySize}" Content="{x:Static p:dnSpy_Debugger_Resources.DbgHistory_Settings_HistorySize}" IsEnabled="{Binding Settings.IsEnabled}" />
            <TextBox Grid.Row="2" Grid.Column="1" Margin="0 5 0 0" Name="histHistorySize" VerticalContentAlignment="Center" Text="{Binding Settings.HistorySize}" IsEnabled="{Binding Settings.IsEnabled}" />
            <Label Grid.Row="3" Grid.Column="0" Margin="0 5 5 0" Target="{Binding ElementName=histMaxFrames}" Content="{x:Static p:dnSpy_Debugger_Resources.DbgHistory_Settings_MaxFrames}" IsEnabled="{Binding Settings.IsEnabled}" />
            <TextBox Grid.Row="3" Grid.Column="1" Margin="0 5 0 0" Name="histMaxFrames" VerticalContentAlignment="Center" Text="{Binding Settings.MaxFrames}" IsEnabled="{Binding Settings.IsEnabled}" />
            <Label Grid.Row="4" Grid.Column="0" Margin="0 5 5 0" Target="{Binding ElementName=histMaxValues}" Content="{x:Static p:dnSpy_Debugger_Resources.DbgHistory_Settings_MaxValues}" IsEnabled="{Binding Settings.IsEnabled}" />
            <TextBox Grid.Row="4" Grid.Column="1" Margin="0 5 0 0" Name="histMaxValues" VerticalContentAlignment="Center" Text="{Binding Settings.MaxValues}" IsEnabled="{Binding Settings.IsEnabled}" />
            <Label Grid.Row="5" Grid.Column="0" Margin="0 5 5 0" Target="{Binding ElementName=histMaxChildren}" Content="{x:Static p:dnSpy_Debugger_Resources.DbgHistory_Settings_MaxChildren}" IsEnabled="{Binding Settings.IsEnabled}" />
            <TextBox Grid.Row="5" Grid.Column="1" Margin="0 5 0 0" Name="histMaxChildren" VerticalContentAlignment="Center" Text="{Binding Settings.MaxChildren}" IsEnabled="{Binding Settings.IsEnabled}" />
            <Label Grid.Row="6" Grid.Column="0" Margin="0 5 5 0" Target="{Binding ElementName=histChildDepth}" Content="{x:Static p:dnSpy_Debugger_Resources.DbgHistory_Settings_ChildDepth}" IsEnabled="{Binding Settings.IsEnabled}" />
            <TextBox Grid.Row="6" Grid.Column="1" Margin="0 5 0 0" Name="histChildDepth" VerticalContentAlignment="Center" Text="{Binding Settings.ChildDepth}" IsEnabled="{Binding Settings.IsEnabled}" />
            <Label Grid.Row="7" Grid.Column="0" Margin="0 5 5 0" Target="{Binding ElementName=histTimeLimitMilliseconds}" Content="{x:Static p:dnSpy_Debugger_Resources.DbgHistory_Settings_TimeLimit}" IsEnabled="{Binding Settings.IsEnabled}" />
            <TextBox Grid.Row="7" Grid.Column="1" Margin="0 5 0 0" Name="histTimeLimitMilliseconds" VerticalContentAlignment="Center" Text="{Binding Settings.TimeLimitMilliseconds}" IsEnabled="{Binding Settings.IsEnabled}" />
        </Grid>
    </DataTemplate>

    <!-- Debug History tool window: a recorded value and its children, compared with the previous stop of the same method frame -->
    <HierarchicalDataTemplate DataType="{x:Type hist:DbgHistoryValueDiff}" ItemsSource="{Binding Children}">
        <StackPanel Orientation="Horizontal">
            <StackPanel.Style>
                <Style TargetType="{x:Type StackPanel}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsGone}" Value="True">
                            <Setter Property="Opacity" Value="0.5" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="{Binding Name}" FontWeight="Bold" />
            <TextBlock Text=" = " />
            <TextBlock Text="{Binding Value.Value}">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                <Setter Property="FontWeight" Value="Bold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding Type, StringFormat='  ({0})'}" Opacity="0.7" />
            <TextBlock Margin="6 0 0 0" Text="{Binding DiffText}" FontStyle="Italic" />
        </StackPanel>
    </HierarchicalDataTemplate>

    <!-- Debug History tool window: stops, and the selected stop's call stack and values (read-only) -->
    <DataTemplate DataType="{x:Type hist:DebugHistoryVM}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="40" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="40" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="2">
                <Button DockPanel.Dock="Left" Margin="0 0 2 0" Padding="4 1" Command="{Binding StepBackCommand}" Content="{x:Static p:dnSpy_Debugger_Resources.DbgHistory_StepBack}" />
                <Button DockPanel.Dock="Left" Margin="0 0 2 0" Padding="4 1" Command="{Binding StepForwardCommand}" Content="{x:Static p:dnSpy_Debugger_Resources.DbgHistory_StepForward}" />
                <Button DockPanel.Dock="Left" Margin="0 0 2 0" Padding="4 1" Command="{Binding ReturnToLiveCommand}" Content="{x:Static p:dnSpy_Debugger_Resources.DbgHistory_ReturnToLive}" />
                <Button DockPanel.Dock="Left" Margin="0 0 8 0" Padding="4 1" Command="{Binding ClearCommand}" Content="{x:Static p:dnSpy_Debugger_Resources.DbgHistory_Clear}" />
                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding StatusText}" />
            </DockPanel>
            <ListView Grid.Row="1" ItemsSource="{Binding Stops}" SelectedItem="{Binding SelectedStop}" SelectionMode="Single">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="#" Width="40" DisplayMemberBinding="{Binding Index}" />
                        <GridViewColumn Header="{x:Static p:dnSpy_Debugger_Resources.DbgHistory_Column_Time}" Width="90" DisplayMemberBinding="{Binding Time}" />
                        <GridViewColumn Header="{x:Static p:dnSpy_Debugger_Resources.DbgHistory_Column_Reason}" Width="80" DisplayMemberBinding="{Binding Reason}" />
                        <GridViewColumn Header="{x:Static p:dnSpy_Debugger_Resources.DbgHistory_Column_Thread}" Width="90" DisplayMemberBinding="{Binding Thread}" />
                        <GridViewColumn Header="{x:Static p:dnSpy_Debugger_Resources.DbgHistory_Column_Method}" Width="350" DisplayMemberBinding="{Binding Method}" />
                        <GridViewColumn Header="{x:Static p:dnSpy_Debugger_Resources.DbgHistory_Column_Location}" Width="160" DisplayMemberBinding="{Binding Location}" />
                        <GridViewColumn Header="{x:Static p:dnSpy_Debugger_Resources.DbgHistory_Column_Changes}" Width="300" DisplayMemberBinding="{Binding Changes}" />
                    </GridView>
                </ListView.View>
            </ListView>
            <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="40" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="40" />
                </Grid.ColumnDefinitions>
                <DockPanel Grid.Column="0">
                    <TextBlock DockPanel.Dock="Top" Margin="2" FontWeight="Bold" Text="{x:Static p:dnSpy_Debugger_Resources.Window_CallStack}" />
                    <ListBox ItemsSource="{Binding Frames}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}">
                                    <TextBlock.InputBindings>
                                        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding DataContext.GoToFrameCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                    </TextBlock.InputBindings>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
                <GridSplitter Grid.Column="1" Width="4" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />
                <DockPanel Grid.Column="2">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2">
                        <TextBlock FontWeight="Bold" Text="{x:Static p:dnSpy_Debugger_Resources.Window_Locals}" />
                        <TextBlock Margin="8 0 0 0" Text="{Binding PartialText}" />
                    </StackPanel>
                    <TreeView ItemsSource="{Binding Values}" />
                </DockPanel>
            </Grid>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
