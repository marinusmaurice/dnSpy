<UserControl x:Class="dnSpy.Debugger.DotNet.HttpTraffic.HttpTrafficControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="clr-namespace:dnSpy.Debugger.DotNet.Properties">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="40" />
        </Grid.RowDefinitions>
        <WrapPanel Grid.Row="0" Margin="2">
            <Button Margin="0 0 6 0" Padding="4 1" Command="{Binding ClearCommand}" Content="{x:Static p:dnSpy_Debugger_DotNet_Resources.HttpTraffic_Clear}" />
            <Button Margin="0 0 6 0" Padding="4 1" Command="{Binding StartCaptureCommand}" Content="{x:Static p:dnSpy_Debugger_DotNet_Resources.HttpTraffic_StartCapture}" ToolTip="{x:Static p:dnSpy_Debugger_DotNet_Resources.HttpTraffic_StartCapture_ToolTip}" />
            <Button Margin="0 0 10 0" Padding="4 1" Command="{Binding ExportHarCommand}" Content="{x:Static p:dnSpy_Debugger_DotNet_Resources.HttpTraffic_ExportHar}" />
            <CheckBox Margin="0 0 10 0" VerticalAlignment="Center" IsChecked="{Binding IsEnabled}" Content="{x:Static p:dnSpy_Debugger_DotNet_Resources.HttpTraffic_Enabled}" ToolTip="{x:Static p:dnSpy_Debugger_DotNet_Resources.HttpTraffic_Enabled_ToolTip}" />
            <CheckBox Margin="0 0 10 0" VerticalAlignment="Center" IsChecked="{Binding CaptureBodies}" Content="{x:Static p:dnSpy_Debugger_DotNet_Resources.HttpTraffic_CaptureBodies}" />
            <TextBlock Margin="0 0 4 0" VerticalAlignment="Center" Foreground="{DynamicResource SystemColorsControlText}" Text="{x:Static p:dnSpy_Debugger_DotNet_Resources.Heap_Filter}" />
            <TextBox Width="180" Margin="0 0 10 0" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource SystemColorsControlText}" TextTrimming="CharacterEllipsis" Text="{Binding StatusText}" />
        </WrapPanel>
        <WrapPanel Grid.Row="1" Margin="2 0 2 2">
            <TextBlock Margin="0 0 4 0" VerticalAlignment="Center" Foreground="{DynamicResource SystemColorsControlText}" Text="{x:Static p:dnSpy_Debugger_DotNet_Resources.HttpTraffic_BreakWhenUrl}" />
            <TextBox Width="160" Margin="0 0 8 0" Text="{Binding BreakUrl, UpdateSourceTrigger=PropertyChanged}" ToolTip="{x:Static p:dnSpy_Debugger_DotNet_Resources.HttpTraffic_BreakWhenUrl_ToolTip}" />
            <CheckBox Margin="0 0 10 0" VerticalAlignment="Center" IsChecked="{Binding BreakOnSend}" Content="{x:Static p:dnSpy_Debugger_DotNet_Resources.HttpTraffic_BreakOnSend}" />
            <TextBlock Margin="0 0 4 0" VerticalAlignment="Center" Foreground="{DynamicResource SystemColorsControlText}" Text="{x:Static p:dnSpy_Debugger_DotNet_Resources.HttpTraffic_BreakOnStatus}" />
            <TextBox Width="50" Margin="0 0 10 0" Text="{Binding BreakStatus, UpdateSourceTrigger=PropertyChanged}" ToolTip="{x:Static p:dnSpy_Debugger_DotNet_Resources.HttpTraffic_BreakOnStatus_ToolTip}" />
            <CheckBox VerticalAlignment="Center" IsChecked="{Binding BreakOnException}" Content="{x:Static p:dnSpy_Debugger_DotNet_Resources.HttpTraffic_BreakOnException}" />
        </WrapPanel>
        <ListView Grid.Row="2" Name="listView" ItemsSource="{Binding EntriesView}" SelectedItem="{Binding SelectedEntry}" SelectionMode="Single" MouseDoubleClick="ListView_MouseDoubleClick">
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{x:Static p:dnSpy_Debugger_DotNet_Resources.HttpTraffic_GoToCode}" Command="{Binding PlacementTarget.DataContext.GoToCodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <MenuItem Header="{x:Static p:dnSpy_Debugger_DotNet_Resources.HttpTraffic_CopyUrl}" Command="{Binding PlacementTarget.DataContext.CopyUrlCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <MenuItem Header="{x:Static p:dnSpy_Debugger_DotNet_Resources.HttpTraffic_CopyCurl}" Command="{Binding PlacementTarget.DataContext.CopyCurlCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Foreground" Value="#FFE05050" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="#" Width="40" DisplayMemberBinding="{Binding Number}" />
                    <GridViewColumn Header="{x:Static p:dnSpy_Debugger_DotNet_Resources.HttpTraffic_Column_Time}" Width="90" DisplayMemberBinding="{Binding TimeText}" />
                    <GridViewColumn Width="30">
                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Direction}" ToolTip="{Binding DirectionToolTip}" /></DataTemplate></GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="{x:Static p:dnSpy_Debugger_DotNet_Resources.HttpTraffic_Column_Method}" Width="60" DisplayMemberBinding="{Binding Method}" />
                    <GridViewColumn Header="{x:Static p:dnSpy_Debugger_DotNet_Resources.AsyncTasks_Column_Status}" Width="60" DisplayMemberBinding="{Binding StatusText}" />
                    <GridViewColumn Header="{x:Static p:dnSpy_Debugger_DotNet_Resources.HttpTraffic_Column_Host}" Width="140" DisplayMemberBinding="{Binding Host}" />
                    <GridViewColumn Header="{x:Static p:dnSpy_Debugger_DotNet_Resources.HttpTraffic_Column_Path}" Width="300" DisplayMemberBinding="{Binding PathAndQuery}" />
                    <GridViewColumn Header="{x:Static p:dnSpy_Debugger_DotNet_Resources.HttpTraffic_Column_Ms}" Width="60" DisplayMemberBinding="{Binding DurationText}" />
                    <GridViewColumn Header="{x:Static p:dnSpy_Debugger_DotNet_Resources.HttpTraffic_Column_Size}" Width="70" DisplayMemberBinding="{Binding SizeText}" />
                    <GridViewColumn Header="{x:Static p:dnSpy_Debugger_DotNet_Resources.HttpTraffic_Column_Code}" Width="300" DisplayMemberBinding="{Binding HandlerText}" />
                </GridView>
            </ListView.View>
        </ListView>
        <GridSplitter Grid.Row="3" Height="4" HorizontalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />
        <TabControl Grid.Row="4" DataContext="{Binding SelectedEntry}">
            <TabItem Header="{x:Static p:dnSpy_Debugger_DotNet_Resources.HttpTraffic_Tab_Request}">
                <TextBox IsReadOnly="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Text="{Binding RequestText, Mode=OneWay}" />
            </TabItem>
            <TabItem Header="{x:Static p:dnSpy_Debugger_DotNet_Resources.HttpTraffic_Tab_Response}">
                <TextBox IsReadOnly="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Text="{Binding ResponseText, Mode=OneWay}" />
            </TabItem>
            <TabItem Header="{x:Static p:dnSpy_Debugger_DotNet_Resources.HttpTraffic_Tab_CallStack}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="2" Foreground="{DynamicResource SystemColorsControlText}" Text="{x:Static p:dnSpy_Debugger_DotNet_Resources.HttpTraffic_CallStack_Help}" />
                    <ListBox Name="framesListBox" ItemsSource="{Binding UserFrames}" MouseDoubleClick="Frames_MouseDoubleClick" />
                </DockPanel>
            </TabItem>
            <TabItem Header="{x:Static p:dnSpy_Debugger_DotNet_Resources.HttpTraffic_Tab_Exception}">
                <TextBox IsReadOnly="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Text="{Binding ExceptionText, Mode=OneWay}" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
