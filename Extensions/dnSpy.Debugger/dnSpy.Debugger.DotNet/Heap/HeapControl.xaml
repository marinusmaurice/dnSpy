<UserControl x:Class="dnSpy.Debugger.DotNet.Heap.HeapControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="clr-namespace:dnSpy.Debugger.DotNet.Properties">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="40" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="2">
            <Button DockPanel.Dock="Left" Margin="0 0 6 0" Padding="4 1" Command="{Binding RefreshCommand}" Content="{x:Static p:dnSpy_Debugger_DotNet_Resources.AsyncTasks_Refresh}" />
            <TextBlock DockPanel.Dock="Left" Margin="0 0 4 0" VerticalAlignment="Center" Foreground="{DynamicResource SystemColorsControlText}" Text="{x:Static p:dnSpy_Debugger_DotNet_Resources.Heap_Filter}" />
            <TextBox DockPanel.Dock="Left" Width="200" Margin="0 0 8 0" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource SystemColorsControlText}" TextTrimming="CharacterEllipsis" Text="{Binding StatusText}" />
        </DockPanel>
        <ListView Grid.Row="1" Name="typesListView" ItemsSource="{Binding TypesView}" SelectedItem="{Binding SelectedType}" SelectionMode="Single" GridViewColumnHeader.Click="TypesHeader_Click">
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="460" DisplayMemberBinding="{Binding TypeName}">
                        <GridViewColumnHeader Content="{x:Static p:dnSpy_Debugger_DotNet_Resources.AsyncTasks_Column_Type}" Tag="TypeName" />
                    </GridViewColumn>
                    <GridViewColumn Width="90">
                        <GridViewColumnHeader Content="{x:Static p:dnSpy_Debugger_DotNet_Resources.Heap_Column_Count}" Tag="Count" />
                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding CountText}" TextAlignment="Right" MinWidth="70" /></DataTemplate></GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="110">
                        <GridViewColumnHeader Content="{x:Static p:dnSpy_Debugger_DotNet_Resources.Heap_Column_Size}" Tag="Size" />
                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding SizeText}" TextAlignment="Right" MinWidth="90" /></DataTemplate></GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="90">
                        <GridViewColumnHeader Content="{x:Static p:dnSpy_Debugger_DotNet_Resources.Heap_Column_CountDelta}" Tag="CountDeltaSort" />
                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding CountDeltaText}" TextAlignment="Right" MinWidth="70" /></DataTemplate></GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="110">
                        <GridViewColumnHeader Content="{x:Static p:dnSpy_Debugger_DotNet_Resources.Heap_Column_SizeDelta}" Tag="SizeDeltaSort" />
                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding SizeDeltaText}" TextAlignment="Right" MinWidth="90" /></DataTemplate></GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
        <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="40" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="40" />
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Margin="2" Foreground="{DynamicResource SystemColorsControlText}" TextTrimming="CharacterEllipsis" Text="{Binding ObjectsText}" />
                <ListView ItemsSource="{Binding Objects}" SelectedItem="{Binding SelectedObject}" SelectionMode="Single">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{x:Static p:dnSpy_Debugger_DotNet_Resources.Heap_Column_Address}" Width="130" DisplayMemberBinding="{Binding Address}" />
                            <GridViewColumn Header="{x:Static p:dnSpy_Debugger_DotNet_Resources.Heap_Column_Fields}" Width="400" DisplayMemberBinding="{Binding Summary}" />
                            <GridViewColumn Header="{x:Static p:dnSpy_Debugger_DotNet_Resources.AsyncTasks_Column_Type}" Width="250" DisplayMemberBinding="{Binding TypeName}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
            <GridSplitter Grid.Column="1" Width="4" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />
            <DockPanel Grid.Column="2">
                <DockPanel DockPanel.Dock="Top" Margin="2">
                    <Button DockPanel.Dock="Left" Margin="0 0 6 0" Padding="4 0" Command="{Binding BackCommand}" Content="{x:Static p:dnSpy_Debugger_DotNet_Resources.Heap_Back}" />
                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource SystemColorsControlText}" TextTrimming="CharacterEllipsis" Text="{Binding FieldsText}" />
                </DockPanel>
                <ListView Name="fieldsListView" ItemsSource="{Binding Fields}" SelectionMode="Single" MouseDoubleClick="Fields_MouseDoubleClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{x:Static p:dnSpy_Debugger_DotNet_Resources.Heap_Column_Name}" Width="160" DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="{x:Static p:dnSpy_Debugger_DotNet_Resources.Heap_Column_Value}" Width="260" DisplayMemberBinding="{Binding Value}" />
                            <GridViewColumn Header="{x:Static p:dnSpy_Debugger_DotNet_Resources.AsyncTasks_Column_Type}" Width="200" DisplayMemberBinding="{Binding TypeName}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
