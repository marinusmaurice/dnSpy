<UserControl x:Class="dnSpy.Debugger.DotNet.AsyncTasks.AsyncTasksControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="clr-namespace:dnSpy.Debugger.DotNet.Properties">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="2">
            <Button DockPanel.Dock="Left" Margin="0 0 6 0" Padding="4 1" Command="{Binding RefreshCommand}" Content="{x:Static p:dnSpy_Debugger_DotNet_Resources.AsyncTasks_Refresh}" />
            <CheckBox DockPanel.Dock="Left" Margin="0 0 8 0" VerticalAlignment="Center" IsChecked="{Binding ShowCompleted}" Content="{x:Static p:dnSpy_Debugger_DotNet_Resources.AsyncTasks_ShowCompleted}" />
            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource SystemColorsControlText}" TextTrimming="CharacterEllipsis" Text="{Binding StatusText}" />
        </DockPanel>
        <ListView Name="listView" ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}" SelectionMode="Single" MouseDoubleClick="ListView_MouseDoubleClick">
            <ListView.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding GoToCommand}" />
            </ListView.InputBindings>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="{x:Static p:dnSpy_Debugger_DotNet_Resources.AsyncTasks_Column_Id}" Width="50" DisplayMemberBinding="{Binding Id}" />
                    <GridViewColumn Header="{x:Static p:dnSpy_Debugger_DotNet_Resources.AsyncTasks_Column_Status}" Width="130" DisplayMemberBinding="{Binding Status}" />
                    <GridViewColumn Header="{x:Static p:dnSpy_Debugger_DotNet_Resources.AsyncTasks_Column_Method}" Width="300" DisplayMemberBinding="{Binding Method}" />
                    <GridViewColumn Header="{x:Static p:dnSpy_Debugger_DotNet_Resources.AsyncTasks_Column_State}" Width="130" DisplayMemberBinding="{Binding State}" />
                    <GridViewColumn Header="{x:Static p:dnSpy_Debugger_DotNet_Resources.AsyncTasks_Column_Type}" Width="450" DisplayMemberBinding="{Binding Type}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
