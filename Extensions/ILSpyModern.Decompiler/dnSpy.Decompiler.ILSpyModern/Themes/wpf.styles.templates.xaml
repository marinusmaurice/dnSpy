<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:settings="clr-namespace:dnSpy.Decompiler.ILSpyModern.Settings"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate DataType="{x:Type settings:CSharpDecompilerSettingsPage}">
        <StackPanel Margin="5">
            <StackPanel Margin="0 0 0 5" Orientation="Horizontal">
                <Label Padding="0 0 5 0" VerticalAlignment="Center" Target="{Binding ElementName=languageVersionComboBox}" Content="_Language version:"/>
                <ComboBox Name="languageVersionComboBox" MinWidth="100" ItemsSource="{Binding LanguageVersions}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Settings.LanguageVersion}"/>
            </StackPanel>
            <CheckBox Margin="0 0 0 0" IsChecked="{Binding Settings.AnonymousMethods}" Content="Decompile anonymous methods/lambdas"/>
            <CheckBox Margin="0 5 0 0" IsChecked="{Binding Settings.YieldReturn}" Content="Decompile enumerators (yield return)"/>
            <CheckBox Margin="0 5 0 0" IsChecked="{Binding Settings.AsyncAwait}" Content="Decompile async methods (async/await)"/>
            <CheckBox Margin="0 5 0 0" IsChecked="{Binding Settings.QueryExpressions}" IsEnabled="{Binding Settings.AnonymousMethods}" Content="Decompile query expressions"/>
            <CheckBox Margin="0 5 0 0" IsChecked="{Binding Settings.ExpressionTrees}" Content="Decompile expression trees"/>
            <CheckBox Margin="0 5 0 0" IsChecked="{Binding Settings.SwitchExpressions}" Content="Decompile switch expressions"/>
            <CheckBox Margin="0 5 0 0" IsChecked="{Binding Settings.StringInterpolation}" Content="Use string interpolation"/>
            <CheckBox Margin="0 5 0 0" IsChecked="{Binding Settings.AutomaticProperties}" Content="Decompile automatic properties"/>
            <CheckBox Margin="0 5 0 0" IsChecked="{Binding Settings.AutomaticEvents}" Content="Decompile automatic events"/>
            <CheckBox Margin="0 5 0 0" IsChecked="{Binding Settings.UsingStatement}" Content="Decompile using statements"/>
            <CheckBox Margin="0 5 0 0" IsChecked="{Binding Settings.ForEachStatement}" Content="Decompile foreach statements"/>
            <CheckBox Margin="0 5 0 0" IsChecked="{Binding Settings.LockStatement}" Content="Decompile lock statements"/>
            <CheckBox Margin="0 5 0 0" IsChecked="{Binding Settings.ObjectOrCollectionInitializers}" Content="Decompile object or collection initializers"/>
            <CheckBox Margin="0 5 0 0" IsChecked="{Binding Settings.IntroduceIncrementAndDecrement}" Content="Use increment and decrement operators"/>
            <CheckBox Margin="0 5 0 0" IsChecked="{Binding Settings.MakeAssignmentExpressions}" Content="Use assignment expressions such as in while ((count = Do()) != 0) ;"/>
            <CheckBox Margin="0 5 0 0" IsChecked="{Binding Settings.SortCustomAttributes}" Content="Sort custom attributes"/>
            <CheckBox Margin="0 5 0 0" IsChecked="{Binding Settings.UsingDeclarations}" Content="Add using declarations"/>
            <CheckBox Margin="0 5 0 0" IsChecked="{Binding Settings.UseDebugSymbols}" Content="Use variable names from debug symbols, if available"/>
            <CheckBox Margin="0 5 0 0" IsChecked="{Binding Settings.ShowXmlDocumentation}" Content="Show XML documentation in decompiled code"/>
            <CheckBox Margin="0 5 0 0" IsChecked="{Binding Settings.ShowTokenAndRvaComments}" Content="Show tokens, RVAs and file offsets in comments"/>
            <CheckBox Margin="0 5 0 0" IsChecked="{Binding Settings.CleanUpOutput}" Content="Clean up ILSpy's output (switch expressions, string interpolation, decimal casts, empty if statements)"/>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
